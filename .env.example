# --- Supabase (Project Settings -> API) ---
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Google Cloud OAuth (APIs & Services -> Credentials) ---
# OAuth 2.0 Web client ID. Add your app origin (e.g. http://localhost:5173) to
# "Authorized JavaScript origins". This is used by Google Identity Services to
# mint a drive.file access token for Picker + Drive uploads.
VITE_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Google Picker needs a Browser API key (APIs & Services -> Credentials -> API key).
# Restrict it to the Picker API + your origins.
VITE_GOOGLE_API_KEY=your-browser-api-key

# Optional: Google Cloud project number, shown by Picker as the app id.
VITE_GOOGLE_APP_ID=
